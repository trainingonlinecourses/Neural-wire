# ── Supabase (required for auth + persistence) ──────────────────────────────
# Create a free project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron protection (Vercel Cron → /api/cron/*) ─────────────────────────────
# Any random string; Vercel sets this header automatically via vercel.json
CRON_SECRET=

# ── Dev mode ─────────────────────────────────────────────────────────────────
# When true and no Supabase URL is set, server pages fall back to live feed
# fetch (no DB) so the UI is fully testable before you wire up Supabase.
DEMO_MODE=true
